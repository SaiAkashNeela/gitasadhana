{
  "name": "gitasadhana",
  "private": true,
  "scripts": {
    "website": "bun run build:website && bunx http-server website -p 5500 -c-1",
    "build:website": "bun website/scripts/build-website-data.mjs && bun website/scripts/build-website-seo.mjs",
    "build:website:og": "bun website/scripts/build-website-og.mjs",
    "build:website:images": "bash website/scripts/build-website-images.sh",
    "api:dev": "bun --cwd api run dev",
    "api:deploy": "bun --cwd api run deploy"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
