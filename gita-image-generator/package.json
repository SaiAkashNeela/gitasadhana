{
  "name": "gita-image-generator",
  "version": "1.0.0",
  "description": "Generate Bhagavad Gita verse images using Google Vertex AI Imagen 4 Ultra",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.js",
    "dev": "bun run src/index.js --mode=dev",
    "generate-prompts": "bun run src/generatePrompts.js",
    "generate-images": "bun run src/generateImages.js",
    "validate-prompts": "bun run src/validatePrompts.js",
    "upload-to-r2": "bun run src/uploadToR2.js"
  },
  "dependencies": {
    "@google-cloud/aiplatform": "^3.20.0",
    "axios": "^1.6.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.52.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
