# Google Cloud Vertex AI Configuration
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_REGION=us-central1
GOOGLE_CREDENTIALS_PATH=./gita-credentials.json

# Imagen Model Configuration
IMAGEN_MODEL=imagen-4.0-ultra-generate-001
IMAGEN_OUTPUT_MIME_TYPE=image/jpeg

# R2 Cloudflare Configuration
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_BUCKET_NAME=gita-audio

# Processing Configuration
BATCH_SIZE=5
MAX_RETRIES=3
IMAGE_GENERATION_ENABLED=true
UPLOAD_TO_R2_ENABLED=true

# Logging
LOG_LEVEL=info
