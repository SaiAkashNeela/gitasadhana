{
  "name": "gita-sadhana-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply gita-sadhana --local",
    "db:migrate:remote": "wrangler d1 migrations apply gita-sadhana --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
