    "jose": "^6.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "vite": "^8.3.3"
  }
}
